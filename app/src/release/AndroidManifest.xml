<!-- Release builds only: remove the ProfileInstaller broadcast receiver, which is exported (behind the
     DUMP permission) purely for benchmarking tools. Baseline Profiles are still installed at startup. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>
</manifest>
