# Copy this file to "keystore.properties" (same folder) and fill in your own values.
# keystore.properties is listed in .gitignore, so it is never uploaded to GitHub.
# See BUILDING.md, step 2, for how to create a keystore.

# Path to your keystore file. Absolute, or relative to the project folder.
storeFile=/home/you/keys/pocketbox-release.jks
storePassword=CHANGE_ME
keyAlias=pocketbox
keyPassword=CHANGE_ME
